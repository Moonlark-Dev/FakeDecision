# FakeDecision environment. Copy to .env and keep .env out of git.
# The first start prints a generated admin password if this is empty.
FAKE_DECISION_ADMIN_EMAIL=admin@fakedecision.local
FAKE_DECISION_ADMIN_PASSWORD=
# Bind address/port (also available as CLI flags).
FAKE_DECISION_HOST=127.0.0.1
FAKE_DECISION_PORT=8790
# SQLite data directory or explicit database path.
FAKE_DECISION_DATA_DIR=./data
# FAKE_DECISION_DATABASE=./data/fakedecision.sqlite3
# Public origin for links and Origin checks (no trailing slash).
FAKE_DECISION_PUBLIC_URL=
# Optional fixed session secret; generated and persisted by default.
FAKE_DECISION_SECRET=
# Comma-separated browser origins for external API clients.
FAKE_DECISION_CORS_ORIGINS=
# Set to 1 only behind a trusted reverse proxy that writes X-Forwarded-*.
FAKE_DECISION_TRUST_PROXY=0
